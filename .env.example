# ===========================================================================
# WYD - variaveis de ambiente (MODELO versionado; segredos NUNCA aqui)
# ===========================================================================
# USO
#   1. Copie:  `cp .env.example .env`  (`.env` esta no .gitignore)
#   2. Preencha os segredos abaixo (geracao: `openssl rand -base64 48`).
#   3. O compose carrega `.env` sozinho (`env_file` + interpolacao `${VAR}`).
#   4. O portal em dev (`npm run dev` em `wyd-portal/`) le `wyd-portal/.env.local`
#      - este arquivo alimenta os SERVICOS (compose); o portal le os mesmos
#      valores via `environment:` no compose. Nao duplique segredo a mao:
#      defina aqui e referencie la.
#
# REGRAS
#   - `.env` real jamais e commitado (ver `.gitignore`: `.env`, `.env.*`,
#     exceto este exemplo). Vazou segredo? Revogue e gere outro.
#   - Os binarios Rust LEEM ambiente em runtime: `DATABASE_URL`,
#     `WYD_GATEWAY_BIND`, `WYD_SERVER_*` (canal, grupo, mapa, idle/stale),
#     `WEB_API_TOKEN`, `AUDIT_LOG_DIR`,
#     `WYD_GAME_ADDR`, `WYD_MAX_CONNECTIONS_PER_IP`, `RUST_LOG`. O que o compose
#     nao define chega por `env_file` do compose ou por `WYD_ENV_FILE` no
#     gateway: o binario Rust NAO carrega `.env` sozinho.
#   - Este modelo descreve a STACK EM EXECUCAO (serie herdada). Um nome de
#     variavel aqui NAO e confirmacao para a 1.0.0: o planejamento novo decide os
#     seus, e pode usar nome que o legado nao usa (ex.: staff por E-MAIL, nao por
#     usuario). Ver `planejamento-1.0.0/wyd-db/`.
#   - Valores `troque-aqui` sao APENAS desenvolvimento local.
#   - Stack 100% Rust (arquivo Go removido em 2026-11; sem referência legada).
#     Serviços futuros entram com a issue dona (ver docs/rust/05-stack-docker.md).
# ===========================================================================

# --- Projeto / imagens (compose) -------------------------------------------
# Nome do projeto (prefixo default dos containers) e tag das imagens locais.
COMPOSE_PROJECT_NAME=wyd
TAG=dev

# --- PostgreSQL (servico `db`: imagem oficial postgres:17-alpine) ----------
# Senha de DESENVOLVIMENTO: e o default local, nao um segredo real. Troque antes
# de publicar a porta fora do loopback (producao nao publica o `db`).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-aqui-dev
POSTGRES_DB=postgres
# Porta publicada no host SOMENTE via override de dev (prod nao publica).
POSTGRES_PORT=5432

# --- Observabilidade (FASE-12-1) -----------------------------------------
# Prometheus/Grafana/node-exporter sobem junto no `docker compose up`; a aba
# /monitoramento do portal le o Prometheus pela rede interna.
# Portas ficam em loopback (127.0.0.1) por padrao.
GRAFANA_USER=admin
GRAFANA_PASSWORD=troque-aqui-dev
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_PORT=9090
# URLs que o BROWSER usa (links "abrir no Prometheus/Grafana" e o iframe do
# /monitoramento). Loopback: os dois serviços nao sao publicos.
PROMETHEUS_PUBLIC_URL=http://127.0.0.1:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_PUBLIC_URL=http://127.0.0.1:3001
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9100
# Portas de dev do Alertmanager e do blackbox-exporter (override), loopback.
ALERTMANAGER_PORT=9093
BLACKBOX_PORT=9115
# Logs durareis: o Alloy coleta o stdout dos containers e grava no Loki (volume
# wyd-loki-data, retencao 14 d). O portal consulta o Loki server-side; nunca o Docker.
LOKI_URL=http://loki:3100

# --- Notificacao de alertas (DEVOPS-02) ------------------------------------
# Destino REAL do Alertmanager: `slack` (default) ou `email`.
# Sem SLACK_API_URL, a integracao Slack faz bootstrap para o receptor local
# (`alert-sink`, volume wyd-alerts-out): a stack funciona e a notificacao fica
# registrada, mas nao entrega a ninguem. Definir a URL real e uma linha.
# Doc/runbook: docs/rust/06-observabilidade-runbooks.md §4.
ALERTMANAGER_DESTINO=slack
SLACK_API_URL=
SLACK_CHANNEL=#canal-alertas
# E-mail (use com ALERTMANAGER_DESTINO=email). SMTP_PASSWORD e segredo.
SMTP_TO=
SMTP_FROM=
SMTP_SMARTHOST=
SMTP_USER=
SMTP_PASSWORD=

# --- Seed de staff: fora do escopo da 1.0.0 -------------------------------
# Seed de staff (login/senha do admin) e do gateway da serie herdada, nao deste
# planejamento (`wyd-db-1.0.0.md` §1.2 deixa `wyd-admin` e portal fora). Nenhuma
# variavel de ambiente da 1.0.0 foi decidida: ver `planejamento-1.0.0/wyd-db/`.

# --- MkDocs (servico `mkdocs`, referencia interna dev/admin) ----------------
# Documentacao interna, sem perfis/autenticacao; o jogador usa o portal.
# Porta publicada apenas em loopback no override de dev; producao nao publica.
MKDOCS_PORT=8000

# --- Portal Next.js (servico `portal`) -------------------------------------
# Sessao httpOnly: >= 32 caracteres. Gere com `openssl rand -base64 48`.
SESSION_SECRET=troque-aqui-com-32-caracteres-no-minimo-0123456789
# Onde o BFF encontra o `wyd-admin` (HTTP/1.1 + JSON, ADR-0008). URL completa,
# loopback na v1. Sem backend no ar, a UI sobe e /api/health responde 502.
# Detalhes em `docs/rust/05-stack-docker.md` e `docs/arquitetura/c4-pacotes.md`.
WEB_API_ADDR=http://127.0.0.1:7600
# Token processo→processo portal → gateway (header `authorization: Bearer`, ADR-0022).
# OBRIGATÓRIO nos dois lados: o gateway não sobe sem ele (fail-closed) e o portal
# não autentica sem ele. Nunca versionado: defina no `.env` local (`openssl rand -hex 24`).
WEB_API_TOKEN=

# --- Gateway HTTP/JSON (servico `gateway`, ADR-0022) ------------------------
# Porta de dev do contrato admin (override publica em loopback); o default do
# compose e 7600, a mesma que `WEB_API_ADDR` do portal usa.
GATEWAY_PORT=7600
# CPSock do servidor de jogo usada pela troca de PIN do portal (`0x0FDE` em
# duas etapas). No compose o valor já aponta para o canal; vazio = 127.0.0.1:8281.
WYD_GAME_ADDR=
# `DATABASE_URL` e montada pelo compose a partir de POSTGRES_* (host `db`), por isso
# não aparece aqui. A porta só é publicada no override de dev, em loopback.
# Auditoria em arquivo (ndjson); o compose monta volume neste caminho.
AUDIT_LOG_DIR=/var/log/wyd-portal
# Porta publicada no host (override de dev).
PORTAL_PORT=3000

# --- Launcher (exe do cliente; FORA do compose) -----------------------------
# Sem variaveis: `update`/`check` recebem tudo por argumento. A imagem
# `docker/Dockerfile.launcher` e artefato de release/smoke (FASE-05-2):
#   docker build -f docker/Dockerfile.launcher -t wyd/launcher:dev .
#   docker run --rm wyd/launcher:dev update /jogo /pacote --key-file /chave.key
WYD_CANAL1_IP=192.168.100.3
WYD_CANAL2_IP=192.168.100.4
